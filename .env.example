# Copy to `.env.local` for local development and set the same variables
# in your hosting provider (Netlify) for production.

# Public site URL used for metadata (optional, defaults to https://marcaurelebesner.com)
NEXT_PUBLIC_SITE_URL=https://marcaurelebesner.com

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# --- Contact form (Resend) ---
# Required. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must use a domain verified in Resend
# (https://resend.com/domains). If left unset, it falls back to
# onboarding@resend.dev, which Resend only lets you send to your own
# Resend account email address.
RESEND_FROM_EMAIL="Contact Form <contact@marcaurelebesner.com>"

# Inbox that receives contact form submissions
# (optional, defaults to contact@marcaurelebesner.com)
RESEND_TO_EMAIL=contact@marcaurelebesner.com
